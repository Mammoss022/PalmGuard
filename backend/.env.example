# Copy to .env and adjust for your environment. Never commit the real .env.

# docs/DATABASE.md targets PostgreSQL.
DATABASE_URL=postgresql+psycopg://palmguard:palmguard@localhost:5432/palmguard

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage — docs/ARCHITECTURE.md#storage-architecture. "local" (below,
# dev only) or "supabase" (deployed app — see app/services/storage.py).
STORAGE_BACKEND=local
STORAGE_DIR=./storage/images
STORAGE_PUBLIC_URL=http://localhost:8000/media
MAX_UPLOAD_SIZE_MB=10

# Only used when STORAGE_BACKEND=supabase. SUPABASE_URL = Project Settings ->
# API -> Project URL. SUPABASE_SERVICE_ROLE_KEY = Project Settings -> API ->
# service_role key (NOT anon — this key never reaches the browser, only the
# Backend uses it). Create the bucket first (Storage -> New bucket -> Public).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=diagnosis-images

CORS_ORIGINS=http://localhost:3000

# Google Gemini Vision — get a free key at https://aistudio.google.com/apikey
# Required either way: used for full classification when AI_BACKEND=gemini
# (app/services/ai_inference.py), and as the "is this a palm leaf?" gate in
# front of the local model when AI_BACKEND=mobilenet (see ai_inference.is_palm_leaf()).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Faster/cheaper model for the is_palm_leaf() gate check — GEMINI_MODEL above
# is a "thinking" model that takes 20-35s for this same yes/no question.
GEMINI_GATE_MODEL=gemini-3.5-flash-lite
PALM_GATE_MIN_CONFIDENCE=0.80
MIN_CONFIDENCE_THRESHOLD=0.55

# Which inference backend app/services/inference.py dispatches to: "mobilenet"
# (default — the real trained model at ai/models/mobilenetv2-v1.2.keras, see
# ai/README.md) or "gemini" (full classification via Gemini alone, no local
# model needed).
AI_BACKEND=mobilenet
MOBILENET_MODEL_PATH=/absolute/path/to/ai/models/mobilenetv2-v1.2.keras
